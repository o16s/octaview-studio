# Stage 1: Build web frontend
# Always build on the native host arch, regardless of the target platform(s) being
# built - this stage only produces static JS/HTML/CSS that gets copied into later
# stages, so running it under QEMU emulation for a foreign target arch just wastes
# time (and, for 32-bit linux/arm/v7, reliably OOMs partway through `yarn install`
# - confirmed: 23+ minutes in, "Libzip Error: ...: Malloc failure").
FROM --platform=$BUILDPLATFORM node:16 AS web-build
WORKDIR /src
RUN corepack enable yarn

# Copy everything (filtered by .dockerignore)
COPY . .

RUN yarn install
RUN yarn run web:build:prod

# Stage 2: Build Go server
FROM golang:1 AS go-build
WORKDIR /src

# Copy go module files and download deps
COPY cmd/foxglove-server/go.mod cmd/foxglove-server/go.sum ./
RUN go mod download

# Copy source
COPY cmd/foxglove-server/*.go ./

# Copy built web assets into dist/ for embedding
COPY --from=web-build /src/web/.webpack dist/

# Build static binary
RUN CGO_ENABLED=0 go build -o /octaview-studio .

# Stage 3: Download static ffmpeg binary (multi-arch)
FROM debian:bookworm-slim AS ffmpeg-fetch
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates && rm -rf /var/lib/apt/lists/*
ARG TARGETARCH
RUN set -eux; \
    case "${TARGETARCH}" in \
      amd64) ARCH=x64 ;; \
      arm64) ARCH=arm64 ;; \
      arm) ARCH=arm ;; \
      *) echo "Unsupported architecture: ${TARGETARCH}" && exit 1 ;; \
    esac; \
    curl -fsSL "https://github.com/eugeneware/ffmpeg-static/releases/latest/download/ffmpeg-linux-${ARCH}.gz" -o /tmp/ffmpeg.gz && \
    gunzip /tmp/ffmpeg.gz && \
    mv /tmp/ffmpeg /usr/local/bin/ffmpeg && \
    chmod +x /usr/local/bin/ffmpeg && \
    /usr/local/bin/ffmpeg -version

# Stage 4: Minimal runtime
FROM gcr.io/distroless/static-debian12:nonroot

COPY --from=go-build /octaview-studio /octaview-studio
COPY --from=ffmpeg-fetch /usr/local/bin/ffmpeg /usr/local/bin/ffmpeg

# Octaview Service Package manifest (edge-hub docs/service-package.md, MAN-1).
# The hub reads it straight out of the layer with the Docker archive endpoint,
# which needs no shell and works on a stopped container. The com.o16s.service
# label deliberately stays in the fleet compose file: MAN-3 compares it with the
# name below to catch a compose entry pointing at the wrong image, and baking the
# label into the image would make that check vacuous.
COPY octaview/manifest.yaml /octaview/manifest.yaml

EXPOSE 8152

VOLUME ["/data/mcap"]
VOLUME ["/data/downloads"]

ENTRYPOINT ["/octaview-studio"]
CMD ["--mcap-path", "/data/mcap", "--port", "8152", "--generate-token"]
